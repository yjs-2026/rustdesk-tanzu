{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rustdesk-tanzu",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"DO_LOCATION_HINT": "apac"
	},
	"routes": [],
	"upload_source_maps": true,
	"migrations": [
		{
			"new_sqlite_classes": [
				"Hbbr",
				"Hbbs"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Hbbr",
				"name": "HBBR"
			},
			{
				"class_name": "Hbbs",
				"name": "HBBS"
			}
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"dev": {
		"port": 80
	}
}
